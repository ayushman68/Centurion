{
  "name": "centurion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:migrate:deploy": "tsx scripts/migrate.ts",
    "db:local": "tsx scripts/local-db.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "better-auth": "1.7.17",
    "pg": "^8.16.3",
    "zod": "^4.1.12",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/pg": "^8.15.6",
    "tailwindcss": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.20.6",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.11.0",
    "embedded-postgres": "18.6.0-beta.19"
  }
}
